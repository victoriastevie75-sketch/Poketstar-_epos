{
  "name": "poketstar-epos",
  "version": "1.1.0",
  "description": "Poket Star POS — Enterprise Desktop & Web POS Environment",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "desktop": "node desktop-launcher.js",
    "build": "node -e \"console.log('Poket Star POS build ready')\"",
    "build:exe": "node scripts/build-native-suite.js",
    "release:desktop": "npm run build:exe",
    "dist": "npm run release:desktop",
    "lint": "echo 'No lint step required'",
    "test": "jest"
  },
  "bin": "desktop-launcher.js",
  "pkg": {
    "scripts": [
      "server.js",
      "server/**/*.js",
      "src/**/*.js",
      "desktop-launcher.js"
    ],
    "assets": [
      "index.html",
      "products.json",
      "manifest.json",
      "sw.js",
      "web/**/*.{html,css,js,json}",
      "src/**/*.{jpg,png,js,css,json}",
      "public/**/*.*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "./dist"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "adm-zip": "^3.0.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "postject": "^1.0.0-alpha.6"
  }
}
